ock;margin-bottom: 6px;font-size: 21px;font-weight: 900}\n\n    .price {display: block;color: var(--text);font-size: 25px;font-weight: 900;letter-spacing: -0.03em}\n\n    .annual {display: block;margin-top: 5px;color: var(--muted);font-size: 12px;font-weight: 500}\n\n    .feature-list {display: grid;gap: 8px;margin: 0;padding: 0;list-style: none}\n\n    .feature-list li {position: relative;padding-left: 19px}\n\n    .feature-list li::before {content: \"✓\";position: absolute;left: 0;color: var(--accent);font-weight: 900}\n\n    .recommended {display: inline-flex;margin-bottom: 13px;padding: 4px 9px;border-radius: 999px;background: var(--accent);color: var(--black);font-size: 10px;font-weight: 900;letter-spacing: 0.08em}\n\n    .plan-note {margin: 18px 0 0;color: var(--muted);font-size: 12px}\n\n    .client-grid {display: grid;grid-template-columns: 0.9fr 1.1fr;gap: 24px}\n\n    .client-card {position: relative;min-height: 360px;display: flex;flex-direction: column;justify-content: flex-end;overflow: hidden;padding: 30px;border: 1px solid var(--line);border-radius: var(--radius);background:\n        linear-gradient(180deg, transparent 30%, rgba(5, 6, 5, 0.92) 76%),\n        linear-gradient(135deg, #1b221c, #101310)}\n\n    .client-card::before {content: \"STC\";position: absolute;top: 25px;right: 20px;color: rgba(183, 255, 60, 0.15);font-size: 82px;font-weight: 950;letter-spacing: -0.08em}\n\n    .client-card p {max-width: 440px;margin: 14px 0 0;color: #b7c0b9;font-size: 14px}\n\n    .client-card .button {align-self: flex-start;margin-top: 24px}\n\n    .steps {display: grid;gap: 12px}\n\n    .step {position: relative;padding: 23px 24px 23px 76px;border: 1px solid var(--line);border-radius: 18px;background: var(--panel)}\n\n    .step-no {position: absolute;top: 22px;left: 22px;color: var(--accent);font-size: 24px;font-weight: 900;letter-spacing: -0.05em}\n\n    .step p {margin: 7px 0 0;color: var(--muted);font-size: 13px}\n\n    .notice {margin-top: 20px;padding: 18px 20px;border-left: 3px solid var(--accent);border-radius: 0 12px 12px 0;background: rgba(183, 255, 60, 0.06);color: #cbd3cc;font-size: 13px}\n\n    .faq-grid {display: grid;grid-template-columns: repeat(2, minmax(0, 1fr));gap: 18px}\n\n    .faq-item {position: relative;overflow: hidden;padding: 27px;border: 1px solid var(--line);border-radius: 20px;background: var(--panel)}\n\n    .faq-item::after {content: \"Q\";position: absolute;right: 12px;bottom: -27px;color: rgba(183, 255, 60, 0.07);font-size: 110px;font-weight: 950;line-height: 1}\n\n    .faq-item h3 {position: relative;z-index: 1;padding-right: 25px;font-size: 18px}\n\n    .faq-item p {position: relative;z-index: 1;margin: 14px 0 0;color: var(--muted);font-size: 14px}\n\n    .faq-item strong {color: var(--text)}\n\n    .faq-wrap {margin-top: 26px}\n\n    .faq-wrap details {border-top: 1px solid var(--line)}\n\n    .faq-wrap details:last-child {border-bottom: 1px solid var(--line)}\n\n    .faq-wrap summary {position: relative;padding: 21px 46px 21px 0;cursor: pointer;list-style: none;font-weight: 800}\n\n    .faq-wrap summary::-webkit-details-marker {display: none}\n\n    .faq-wrap summary::after {content: \"+\";position: absolute;top: 17px;right: 4px;color: var(--accent);font-size: 24px;font-weight: 400}\n\n    .faq-wrap details[open] summary::after {content: \"−\"}\n\n    .faq-wrap details p {max-width: 850px;margin: 0;padding: 0 50px 23px 0;color: var(--muted);font-size: 14px}\n\n    .footer {padding: 44px 0;border-top: 1px solid rgba(255, 255, 255, 0.08);color: var(--muted);font-size: 12px}\n\n    .footer-inner {display: flex;align-items: center;justify-content: space-between;gap: 24px}\n\n    .footer-links {display: flex;flex-wrap: wrap;gap: 18px}\n\n    .footer a:hover {color: var(--accent)}\n\n    @media (max-width: 900px) {\n      .nav {display: none}\n\n      .hero-grid,\n      .section-head,\n      .client-grid {grid-template-columns: 1fr}\n\n      .hero-grid {gap: 42px}\n\n      .section-head {gap: 20px}\n    }\n\n    @media (max-width: 680px) {\n      .shell {width: min(calc(100% - 28px), var(--max))}\n\n      .topbar-inner {min-height: 66px}\n\n      .hero {padding: 52px 0 68px}\n\n      .breadcrumb {margin-bottom: 30px}\n\n      h1 {font-size: clamp(48px, 17vw, 76px)}\n\n      .hero-panel {padding: 24px}\n\n      .section {padding: 66px 0}\n\n      .faq-grid {grid-template-columns: 1fr}\n\n      .actions .button {width: 100%}\n\n      .footer-inner {align-items: flex-start;flex-direction: column}\n    }\n  </style><header class=\"topbar\">\n    <div class=\"shell topbar-inner\">\n      <a class=\"brand\" href=\"#top\" aria-label=\"STC 首页\">\n        <span class=\"brand-mark\">STC</span>\n        <span>STC</span>\n      </a>\n      <nav class=\"nav\" aria-label=\"页面目录\">\n        <a href=\"#plans\">机场套餐</a>\n        <a href=\"#clients\">机场客户端</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n        <a class=\"nav-cta\" href=\"#plans\">查看方案</a>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"top\">\n    <section class=\"hero\">\n      <div class=\"shell\">\n        <div class=\"breadcrumb\" aria-label=\"面包屑导航\">\n          <a href=\"#top\">首页</a>\n          <span>/</span>\n          <a href=\"#plans\">套餐与客户端</a>\n          <span>/</span>\n          <span>信息指南</span>\n        </div>\n\n        <div class=\"hero-grid\">\n          <div>\n            <div class=\"eyebrow\">STC 信息导航</div>\n            <h1>STC 套餐与客户端，<em>先看懂再选择</em></h1>\n            <p class=\"lead\">从流量额度、设备数量到客户端使用流程，集中整理 STC 机场套餐、机场客户端与基础使用说明，帮助你快速判断哪种方案更适合日常使用。</p>\n            <div class=\"actions\">\n              <a class=\"button primary\" href=\"#plans\">对比套餐 <span>→</span></a>\n              <a class=\"button\" href=\"#guide\">查看使用步骤</a>\n            </div>\n          </div>\n\n          <aside class=\"hero-panel\" aria-label=\"页面摘要\">\n            <div class=\"panel-label\">\n              <span>QUICK VIEW</span>\n              <span class=\"status\">信息已整理</span>\n            </div>\n            <h2>三档方案，一页看懂</h2>\n            <p>按照个人、多设备和团队协作需求，对照流量、设备与附加权益。</p>\n            <ul class=\"mini-list\">\n              <li><span>可选套餐</span><strong>3 档</strong></li>\n              <li><span>设备上限</span><strong>3—20 台</strong></li>\n              <li><span>月度流量</span><strong>100—1000GB</strong></li>\n              <li><span>使用指引</span><strong>4 步</strong></li>\n            </ul>\n          </aside>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"plans\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"section-no\">01 / 套餐对比</div>\n            <h2>按需求选，不按价格猜</h2>\n          </div>\n          <p class=\"section-intro\">以下为 STC 机场套餐参考信息。购买前建议再次核对服务规则、有效期、可用范围与实际交付说明。</p>\n        </div>\n\n        <div class=\"table-wrap\">\n          <table>\n            <thead>\n              <tr>\n                <th>对比项目</th>\n                <th>基础版</th>\n                <th>旗舰版</th>\n                <th>团队版</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <th>月度价格</th>\n                <td><span class=\"price\">¥15</span><span class=\"annual\">每月</span></td>\n                <td><span class=\"price\">¥35</span><span class=\"annual\">每月</span></td>\n                <td><span class=\"price\">¥85</span><span class=\"annual\">每月</span></td>\n              </tr>\n              <tr>\n                <th>年度价格</th>\n                <td><span class=\"price\">¥150</span><span class=\"annual\">按年付</span></td>\n                <td><span class=\"price\">¥350</span><span class=\"annual\">按年付</span></td>\n                <td><span class=\"price\">¥850</span><span class=\"annual\">按年付</span></td>\n              </tr>\n              <tr>\n                <th>流量额度</th>\n                <td>每月 100GB</td>\n                <td>每月 300GB</td>\n                <td>每月 1000GB</td>\n              </tr>\n              <tr>\n                <th>同时在线</th>\n                <td>支持 3 台设备</td>\n                <td>支持 5 台设备</td>\n                <td>支持 20 台设备</td>\n              </tr>\n              <tr>\n                <th>主要权益</th>\n                <td>\n                  <ul class=\"feature-list\">\n                    <li>解锁基础流媒体</li>\n                    <li>普通线路节点池</li>\n                  </ul>\n                </td>\n                <td>\n                  <span class=\"recommended\">推荐选择</span>\n                  <ul class=\"feature-list\">\n                    <li>全节点原生流媒体解锁</li>\n                    <li>IPLC 专线游戏加速优化</li>\n                    <li>7×24 优先工单支持</li>\n                  </ul>\n                </td>\n                <td>\n                  <ul class=\"feature-list\">\n                    <li>VIP 专属高带宽节点</li>\n                    <li>支持企业定制路由</li>\n                    <li>专属客户经理服务</li>\n                  </ul>\n                </td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n        <p class=\"plan-note\">价格与权益以实际提供的套餐说明为准；本页面不提供交易入口，也不设置虚构购买按钮。</p>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"clients\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"section-no\">02 / 客户端</div>\n            <h2>客户端怎么选，怎么用</h2>\n          </div>\n          <p class=\"section-intro\">客户端应从可靠且实际可用的渠道获取。下载前核对发布方、版本信息与设备系统，避免安装来源不明的文件。</p>\n        </div>\n\n        <div class=\"client-grid\">\n          <article class=\"client-card\">\n            <h3>STC 机场客户端</h3>\n            <p>当前资料未提供经过核验的客户端名称、适用系统与下载地址，因此这里不虚构下载链接。获取客户端时，应以 STC 实际提供的安装说明和配置指引为准。</p>\n            <a class=\"button\" href=\"#guide\">阅读通用配置步骤</a>\n          </article>\n\n          <div class=\"steps\" aria-label=\"客户端准备步骤\">\n            <article class=\"step\">\n              <span class=\"step-no\">01</span>\n              <h3>确认设备与系统</h3>\n              <p>先确认准备安装客户端的设备型号和操作系统，再选择对应版本，避免下载后无法使用。</p>\n            </article>\n            <article class=\"step\">\n              <span class=\"step-no\">02</span>\n              <h3>通过可靠渠道获取</h3>\n              <p>从实际服务提供方给出的地址或说明中获取安装文件，并核对文件名称与版本信息。</p>\n            </article>\n            <article class=\"step\">\n              <span class=\"step-no\">03</span>\n              <h3>导入必要配置</h3>\n              <p>按照交付说明填写订阅地址或导入配置文件。敏感信息只填写到实际客户端中，不应上传到陌生页面。</p>\n            </article>\n            <article class=\"step\">\n              <span class=\"step-no\">04</span>\n              <h3>检查连接状态</h3>\n              <p>启动客户端后检查连接状态与设备数量限制。如遇异常，先依据客户端提示排查，再寻求帮助。</p>\n            </article>\n          </div>\n        </div>\n\n        <div class=\"notice\">提示：没有经过核验的下载地址时，不建议从第三方网盘、群文件或不明转载页下载。客户端来源与配置方式应以实际交付说明为准。</div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"guide\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"section-no\">03 / 使用说明</div>\n            <h2>从安装到连接，四步完成</h2>\n          </div>\n          <p class=\"section-intro\">不同客户端的操作路径可能不同，以下流程用于快速理解配置顺序，不替代具体版本的界面指引。</p>\n        </div>\n\n        <div class=\"steps\">\n          <article class=\"step\">\n            <span class=\"step-no\">01</span>\n            <h3>安装并打开客户端</h3>\n            <p>完成安装后启动客户端，根据实际界面完成基础设置。若系统出现安全提示，请先核对安装来源，再决定是否继续。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-no\">02</span>\n            <h3>添加订阅或配置</h3>\n            <p>使用服务说明中提供的订阅地址或配置文件，导入后等待客户端读取。配置失败时，不要反复提交来源不明的信息。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-no\">03</span>\n            <h3>选择节点并连接</h3>\n            <p>根据实际网络环境选择合适节点并发起连接。节点名称与线路参数仅作界面参考，具体内容以客户端显示为准。</p>\n          </article>\n          <article class=\"step\">\n            <span class=\"step-no\">04</span>\n            <h3>验证并管理设备</h3>\n            <p>连接成功后检查访问状态与套餐设备数量，并在多设备场景中关闭不用的在线设备，减少超出上限的可能。</p>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"section\" id=\"faq\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <div class=\"section-no\">04 / 常见问题</div>\n            <h2>你可能正在问</h2>\n          </div>\n          <p class=\"section-intro\">先从高频问题中找到答案。如果账户、续费或配置问题仍未解决，请整理设备、客户端版本与错误提示后联系服务方。</p>\n        </div>\n\n        <div class=\"faq-grid\">\n          <article class=\"faq-item\">\n            <h3>STC 机场基础版适合哪些使用场景？</h3>\n            <p>参考权益显示，基础版提供<strong>每月 100GB</strong>流量，并支持<strong>3 台设备同时在线</strong>，可作为个人日常使用的入门选择。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>旗舰版与基础版的主要区别是什么？</h3>\n            <p>参考信息中，旗舰版为每月 300GB、5 台设备同时在线，并增加原生流媒体解锁、游戏加速优化和优先工单等权益。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>团队版适合多少设备？</h3>\n            <p>参考权益显示，团队版支持<strong>20 台设备同时在线</strong>，每月流量额度为 1000GB，适合设备数量较多的使用场景。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>在哪里获取 STC 机场客户端？</h3>\n            <p>目前没有经过核验的下载地址，因此本页不提供安装链接。应通过实际服务方公布的可靠渠道获取，并核对客户端版本与来源。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>年付套餐与月付套餐如何选择？</h3>\n            <p>如果使用需求稳定且已确认套餐规则，可对比年付与月付的周期成本；如果仍需试用，可优先选择月付，先验证客户端与使用体验。</p>\n          </article>\n          <article class=\"faq-item\">\n            <h3>连接异常时应该检查什么？</h3>\n            <p>先确认客户端版本、订阅状态、设备数量和网络环境，再查看具体错误提示。记录必要信息后联系服务方，避免提供密码或完整私密配置。</p>\n          </article>\n        </div>\n\n        <div class=\"faq-wrap\">\n          <details>\n            <summary>套餐显示的流量是每月重置吗？</summary>\n            <p>本页参考套餐以“每月 100GB、300GB、1000GB”描述流量额度。实际重置周期、计量方式、超额处理及有效期，应以购买时提供的套餐规则为准。</p>\n          </details>\n          <details>\n            <summary>可以同时在线多台设备吗？</summary>\n            <p>可以，但需要符合所选套餐的设备上限。参考方案分别为 3 台、5 台和 20 台设备同时在线；超出限制时应先关闭闲置设备。</p>\n          </details>\n          <details>\n            <summary>客户端配置导入失败怎么办？</summary>\n            <p>先检查订阅地址或配置文件是否完整、设备时间是否准确、客户端是否为对应版本。若仍失败，请记录客户端版本、导入时间和错误提示，再联系服务方排查。</p>\n          </details>\n          <details>\n            <summary>页面没有下载按钮是遗漏吗？</summary>\n            <p>不是。当前没有提供经过确认的客户端下载信息，为避免引导至错误或不可靠的文件来源，本页仅整理通用使用步骤，不设置下载入口。</p>\n          </details>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"footer\">\n    <div class=\"shell footer-inner\">\n      <div>© <span id=\"year\">2026</span> STC 信息指南 · 套餐、客户端与使用说明</div>\n      <div class=\"footer-links\">\n        <a href=\"#plans\">套餐</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#guide\">使用说明</a>\n        <a href=\"#faq\">常见问题</a>\n      </div>\n    </div>\n  </footer>",
